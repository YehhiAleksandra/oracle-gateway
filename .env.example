OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-oss-120b:free
OPENAI_MODEL_FALLBACKS=poolside/laguna-xs.2:free,nex-agi/nex-n2-pro:free
OPENAI_VISION_MODEL=google/gemma-3-12b-it:free
OPENAI_VISION_FALLBACKS=google/gemma-4-26b-a4b-it:free
LLM_PER_MODEL_TIMEOUT_SEC=50
LLM_READING_TIMEOUT_SEC=120
GATEWAY_ADDR=127.0.0.1:8080

# Optional per-task model chains (comma-separated, first = primary)
